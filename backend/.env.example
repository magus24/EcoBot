# Скопируйте в .env и подставьте свои значения.
# SECRET_KEY обязателен в продакшене: им подписываются токены входа.

SECRET_KEY=change-me-to-a-long-random-string

# Сетевые настройки dev-сервера
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Пути (по умолчанию — backend/ecobot.db и backend/media)
DATABASE_PATH=./ecobot.db
UPLOAD_FOLDER=./media

# Время жизни токена входа, секунды (по умолчанию 12 часов)
ECOBOT_TOKEN_MAX_AGE=43200
